class City {}

class Location {

    City city;

    Location(City city) : city(city) {}
}

class Airport : Location {

    Airport(City city) : Location(city) {}
}

class Truck : StateVariable {

    predicate At(Location l) : Interval {
        duration >= 1;
        goal going = new GoingTo(end:start, to:l)!;
    }

    predicate GoingTo(Location from, Location to) : Interval {
        duration >= 1;
        from.city == to.city;
        goal at = new At(end:start, l:from);
    }
}

class Airplane : StateVariable {

    predicate At(Airport l) : Interval {
        duration >= 1;
        goal flying = new Flying(end:start, to:l)!;
    }

    predicate Flying(Airport from, Airport to) : Interval {
        duration >= 1;
        goal at = new At(end:start, l:from);
    }
}

class Package : StateVariable {

    predicate At(Location l) : Interval {
        duration >= 1;
        {
            goal unload = new UnloadTruck(end:start, l:l)!;
        } or {
            Airport air;
            air == l;
            goal unload = new UnloadAirplane(end:start, l:air)!;
        }
    }

    predicate InTruck(Truck t) : Interval {
        duration >= 1;
        goal load = new LoadTruck(end:start, t:t)!;
    }

    predicate InAirplane(Airplane a) : Interval {
        duration >= 1;
        goal load = new LoadAirplane(end:start, a:a)!;
    }

    predicate LoadTruck(Truck t, Location l) : Interval {
        duration >= 1;
        goal p_at = new At(end:start, l:l);
        goal t_at = new t.At(l:l);
        t_at.start <= start;
        t_at.end >= end;
    }

    predicate UnloadTruck(Truck t, Location l) : Interval {
        duration >= 1;
        goal p_in = new InTruck(end:start, t:t);
        goal t_at = new t.At(l:l);
        t_at.start <= start;
        t_at.end >= end;
    }

    predicate LoadAirplane(Airplane a, Airport l) : Interval {
        duration >= 1;
        goal p_at = new At(end:start, l:l);
        goal a_at = new a.At(l:l);
        a_at.start <= start;
        a_at.end >= end;
    }

    predicate UnloadAirplane(Airplane a, Airport l) : Interval {
        duration >= 1;
        goal p_in = new InAirplane(end:start, a:a);
        goal a_at = new a.At(l:l);
        a_at.start <= start;
        a_at.end >= end;
    }
}